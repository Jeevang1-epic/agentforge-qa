{
  "name": "@agentforge-qa/testkit",
  "version": "0.1.0",
  "private": true,
  "description": "Test-only helpers for AgentForge QA.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/testkit/src/index.test.ts tests/integration",
    "lint": "cd ../.. && eslint packages/testkit/src tests/integration"
  }
}
